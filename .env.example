# =============================================================================
#  ÖRNEK dosya — kullanmak için '.env' adıyla kopyalayın ve doldurun.
#  '.env' dosyası .gitignore'da olduğu için depoya girmez.
# =============================================================================

# SQL Server SA parolası.
# Kural: en az 8 karakter; büyük harf, küçük harf, rakam ve sembol içermeli.
MSSQL_SA_PASSWORD=

# JWT imza anahtarı — en az 32 karakter, rastgele.
# Üretmek için:
#   Linux/macOS : openssl rand -base64 48
#   Windows     : [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECURITY_KEY=

# Yönetici hesabı parolası.
# Boş bırakılırsa: geliştirme ortamında rastgele üretilip bir kez loglanır,
# üretim ortamında yönetici hesabı hiç oluşturulmaz.
SEED_ADMIN_PASSWORD=
